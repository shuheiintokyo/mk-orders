# Notion internal integration secret (notion.so/profile/integrations). Server-only, never shared.
NOTION_TOKEN=ntn_xxx
# MK Orders data source id (already filled in)
NOTION_DATA_SOURCE_ID=4212e44d-4610-81f4-b9ff-000b5b8bdd71
# Password for Shuhei (full admin)
ADMIN_PASSWORD=choose-a-long-password
# Password for Kobe (to do view only)
KOBE_PASSWORD=choose-another-password
# Any long random text, used to sign the login cookie
SESSION_SECRET=paste-a-long-random-string
# Optional: Notion page used as the public front page (defaults to MK Production · News Watch)
# NEWS_PAGE_ID=4192e44d4610816fabc0d4d05ad6f251
# Contact form: free access key from web3forms.com (messages go to the email you register there)
WEB3FORMS_KEY=
# Daily social posts (X, Threads, Instagram through Buffer's free plan)
# Buffer API key: publish.buffer.com/settings/api > Personal Access > + New Key
BUFFER_API_KEY=
# Any long random text; Vercel Cron sends it so only the cron can post
CRON_SECRET=
# Optional: public site address used in posts (default https://mkproductionlab.com)
# SITE_URL=https://mkproductionlab.com
# Optional: set to 1 to pause posting without removing the key
# SOCIAL_PAUSED=1
